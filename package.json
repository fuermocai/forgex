{
  "name": "forgex",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "description": "ForgeX - TUI-first coding & DevOps agent runtime",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:npm": "pnpm build && tsup --config tsup.npm.config.ts && node scripts/prepare-npm.mjs",
    "pack:npm": "pnpm build:npm && npm pack ./dist-npm",
    "pack:npm:dry": "pnpm build:npm && npm pack ./dist-npm --dry-run",
    "publish:npm": "pnpm build:npm && npm publish ./dist-npm --access public",
    "smoke:npm": "node scripts/install-smoke.mjs",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node tests/bench/run-bench.mjs",
    "benchmark": "node benchmark/run-benchmark.mjs",
    "eval:task": "node --no-warnings eval/task/run.mjs",
    "eval:task:ci": "node --no-warnings eval/task/run.mjs --ci --out eval/results/task-eval-ci.json",
    "eval:task:selftest": "node --no-warnings eval/task/selftest.mjs",
    "eval:task:live": "node --no-warnings eval/task/live.mjs",
    "cargo:build": "cargo build --release --manifest-path crates/executor/Cargo.toml",
    "cargo:test": "cargo test --manifest-path crates/executor/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.12",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
