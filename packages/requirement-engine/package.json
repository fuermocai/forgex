{
  "name": "@forgex/requirement-engine",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@forgex/shared": "workspace:*",
    "@forgex/models": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.2"
  }
}
