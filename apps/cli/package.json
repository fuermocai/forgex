{
  "name": "forgex-agent",
  "version": "0.5.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "forgex": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@forgex/core": "workspace:*",
    "@forgex/devops": "workspace:*",
    "@forgex/models": "workspace:*",
    "@forgex/security": "workspace:*",
    "@forgex/shared": "workspace:*",
    "@forgex/tools": "workspace:*",
    "ink": "5.2.1",
    "react": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.12",
    "typescript": "5.9.2"
  }
}
